# 复制为 .env.development / .env.production 后填写真实值
# cp .env.example .env.development

# 系统环境：development | production
VITE_APP_ENV=development

# 业务后端地址（登录、计费、管理接口）
VITE_APP_REQUEST_HOST=https://your-api-domain.example.com/apiAI

# LLM 接口地址。同域部署时用反向代理路径，例如 /v1
VITE_LLM_BASE_URL=/v1

# 开发环境 LLM 代理目标（vite.config.ts 使用）
VITE_LLM_PROXY_TARGET=https://your-llm-domain.example.com

# 客服联系方式（支付问题提示），留空则不显示
VITE_SUPPORT_PHONE=10000000000

# 前端管理员手机号白名单，多个用英文逗号分隔；留空则仅依赖后端 is_staff / role 判断
VITE_ADMIN_PHONES=
